# Porta da API
PORT=3001
# Origem(ns) do frontend liberadas no CORS (separadas por vírgula)
FRONTEND_ORIGIN=http://localhost:3000
# Arquivo SQLite (use :memory: nos testes)
DATABASE_PATH=data/personutri.sqlite
# Tokens de acesso (um por dispositivo, separados por vírgula, mín. 16 caracteres; gere com `openssl rand -hex 24`).
# Vazio = API aberta (só para desenvolvimento local). Em produção a API se recusa a subir sem tokens.
API_TOKENS=
# Limite geral de requisições por minuto, por IP
# RATE_LIMIT_PER_MIN=600
# Atrás de um proxy reverso (Caddy), defina TRUST_PROXY=1 para enxergar o IP real
# TRUST_PROXY=1
# Fuso usado para "hoje" no servidor
APP_TIMEZONE=America/Sao_Paulo
# Open Food Facts: identifique seu app (exigido pela API) e, se quiser, troque o host
OFF_USER_AGENT=PersoNutri/0.1 (seu-email@exemplo.com)
# OFF_BASE_URL=https://world.openfoodfacts.org
# OFF_TIMEOUT_MS=10000
