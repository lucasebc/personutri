# Domínio público apontando para este servidor (portas 80 e 443 abertas). Use "localhost" para testar.
SITE_ADDRESS=nutri.seudominio.com

# Um token por dispositivo, separados por vírgula (mín. 16 caracteres). Gere com:  openssl rand -hex 24
API_TOKENS=

# Identificação exigida pelo Open Food Facts
OFF_USER_AGENT=PersoNutri/0.1 (seu@email.com)
APP_TIMEZONE=America/Sao_Paulo
