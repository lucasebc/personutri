# Site estático (Next.js exportado) + Caddy com HTTPS automático. Contexto de build: raiz do repositório.
FROM node:22-bookworm-slim AS web
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
ENV NEXT_EXPORT=1 \
    NEXT_PUBLIC_API_URL=/api \
    NEXT_TELEMETRY_DISABLED=1
RUN npx next build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /app/out /srv/web
